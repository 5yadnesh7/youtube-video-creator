OPENROUTER_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional fallback for text generation when OpenRouter is rate limited or down.
# Create a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b   # leave unset to pick one automatically
# OLLAMA_BASE_URL=https://ollama.com

# Order in which text providers are tried (comma separated).
# LLM_PROVIDERS=openrouter,ollama

# Redo the whole video with an Edge voice if the chosen OpenRouter voice is unavailable.
# TTS_FALLBACK_TO_EDGE=true
